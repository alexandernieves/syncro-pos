generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Business {
  id                 String              @id @default(uuid())
  name               String
  status             String              @default("ACTIVE")
  subscription       String              @default("BASIC")
  logo               String?
  ruc                String?
  email              String?
  phone              String?
  address            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  feedbacks          AiFeedback[]
  auditLogs          AuditLog[]
  branches           Branch[]
  categories         Category[]
  clients            Client[]
  conversations      Conversation[]
  deliveryOrders     DeliveryOrder[]
  expenses           Expense[]
  paymentSubmissions PaymentSubmission[]
  products           Product[]
  sales              Sale[]
  settings           Setting[]
  suppliers          Supplier[]
  users              User[]
}

model Conversation {
  id          String    @id @default(uuid())
  businessId  String?
  lastMessage String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  business    Business? @relation(fields: [businessId], references: [id])
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  type           String       @default("TEXT")
  fileUrl        String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model Product {
  id               String            @id @default(uuid())
  name             String
  description      String?
  categoryId       String?
  supplierId       String?
  isWeighable      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  image            String?
  businessId       String?
  business         Business?         @relation(fields: [businessId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  variants         ProductVariant[]
  supplierProducts SupplierProduct[]
}

model ProductVariant {
  id                 String                  @id @default(uuid())
  productId          String
  name               String
  sku                String
  barcode            String?
  secondaryBarcodes  String[]                @default([])
  price              Float
  cost               Float?
  promoPrice         Float?
  bulkPrice          Float?
  stock              Int                     @default(0)
  minStock           Int                     @default(5)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  inventory          Inventory[]
  movements          InventoryMovement[]
  transferItems      InventoryTransferItem[]
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]
  supplierProducts   SupplierProduct[]
  supplierReturns    SupplierReturn[]
}

model Inventory {
  id        String         @id @default(uuid())
  variantId String
  branchId  String
  quantity  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String?
  description String?
  business    Business? @relation(fields: [businessId], references: [id])
  products    Product[]

  @@unique([businessId, name])
}

model Supplier {
  id               String            @id @default(uuid())
  name             String
  taxId            String?           @unique
  phone            String?
  email            String?
  address          String?
  status           SupplierStatus    @default(ACTIVE)
  contactName      String?
  paymentTerms     String?           @default("CONTADO")
  creditDays       Int?              @default(0)
  website          String?
  notes            String?
  taxType          String?           @default("ORDINARIO")
  bankName         String?
  bankAccount      String?
  bankId           String?
  bankPhone        String?
  currency         String?           @default("USD")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  businessId       String?
  products         Product[]
  purchaseOrders   PurchaseOrder[]
  business         Business?         @relation(fields: [businessId], references: [id])
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  supplierProducts SupplierProduct[]
  supplierReturns  SupplierReturn[]

  @@unique([businessId, name])
}

model Branch {
  id                 String              @id @default(uuid())
  name               String
  location           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  country            String?
  isMain             Boolean             @default(false)
  state              String?
  businessId         String?
  email              String?
  phone              String?
  accountingEntries  AccountingEntry[]
  business           Business?           @relation(fields: [businessId], references: [id])
  expenses           Expense[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  transfersDest      InventoryTransfer[] @relation("DestinationBranch")
  transfersSource    InventoryTransfer[] @relation("SourceBranch")
  notifications      Notification[]      @relation("BranchNotifications")
  waitlistItems      ProductWaitlist[]
  purchaseOrders     PurchaseOrder[]
  sales              Sale[]
  shifts             Shift[]

  @@unique([businessId, name])
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  name              String?
  role              String              @default("pos")
  country           String?
  city              String?
  avatar            String?
  permissions       String[]            @default([])
  branchIds         String[]            @default([])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  businessId        String?
  lastSeen          DateTime?
  accountingEntries AccountingEntry[]
  auditLogs         AuditLog[]
  expenses          Expense[]
  transfers         InventoryTransfer[]
  messages          Message[]
  notifications     Notification[]      @relation("UserNotifications")
  pushSubscriptions PushSubscription[]
  sales             Sale[]
  returns           SaleReturn[]
  shifts            Shift[]
  business          Business?           @relation(fields: [businessId], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Setting {
  id                          String    @id @default(uuid())
  businessName                String    @default("Syncro POS")
  businessAddress             String?
  businessPhone               String?
  businessEmail               String?
  businessIcon                String?
  ruc                         String?   @default("")
  address                     String?   @default("")
  phone                       String?   @default("")
  email                       String?   @default("")
  website                     String?   @default("")
  country                     String?   @default("Venezuela")
  currency                    String    @default("USD")
  exchangeRate                Float     @default(1)
  exchangeRateEur             Float     @default(1)
  bcvUpdateDate               String?
  exchangeRateDashboard       Float     @default(1)
  exchangeRateDashboardEur    Float     @default(1)
  bcvUpdateDateDashboard      String?
  taxRate                     Float     @default(16)
  taxEnabled                  Boolean   @default(true)
  igtfRate                    Float     @default(3)
  receiptFooter               String?   @default("Gracias por su compra. Vuelva pronto.")
  pagoMovilBank               String?
  pagoMovilId                 String?
  pagoMovilPhone              String?
  pagoMovilEnabled            Boolean?  @default(false)
  binanceId                   String?
  binanceEmail                String?
  binanceEnabled              Boolean?  @default(false)
  zinliEmail                  String?
  zinliEnabled                Boolean?  @default(false)
  paypalEmail                 String?
  paypalEnabled               Boolean?  @default(false)
  requireClient               Boolean   @default(false)
  printOnSale                 Boolean   @default(true)
  lowStockAlert               Int       @default(5)
  allowNegativeStock          Boolean   @default(false)
  defaultPrinter              String?   @default("")
  paperWidth                  Int       @default(80)
  copiesPerSale               Int       @default(1)
  paymentMethods              Json?
  discountPin                 String?
  pinPermissions              Json?
  salesGoal                   Float     @default(10000)
  showSalesGoal               Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  businessId                  String?
  showNetMargin               Boolean   @default(true)
  syncroCreditFrequencyDays   Int       @default(15)
  syncroCreditMaxInstallments Int       @default(3)
  business                    Business? @relation(fields: [businessId], references: [id])
}

model Sale {
  id              String           @id @default(uuid())
  branchId        String
  userId          String
  clientId        String?
  paymentMethod   PaymentMethod?
  subtotal        Float            @default(0)
  taxAmount       Float            @default(0)
  igtfAmount      Float            @default(0)
  discountAmt     Float            @default(0)
  discountPct     Float            @default(0)
  total           Float
  status          String           @default("COMPLETED")
  shiftId         String?
  createdAt       DateTime         @default(now())
  businessId      String?
  accountingEntry AccountingEntry?
  branch          Branch           @relation(fields: [branchId], references: [id])
  business        Business?        @relation(fields: [businessId], references: [id])
  client          Client?          @relation(fields: [clientId], references: [id])
  shift           Shift?           @relation(fields: [shiftId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  returns         SaleReturn[]
}

model SaleReturn {
  id        String           @id @default(uuid())
  saleId    String
  userId    String
  reason    String?
  subtotal  Float            @default(0)
  taxAmount Float            @default(0)
  total     Float
  createdAt DateTime         @default(now())
  sale      Sale             @relation(fields: [saleId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  items     SaleReturnItem[]
}

model SaleReturnItem {
  id        String          @id @default(uuid())
  returnId  String
  variantId String?
  quantity  Int
  price     Float
  subtotal  Float
  return    SaleReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model SalePayment {
  id           String        @id @default(uuid())
  saleId       String
  method       PaymentMethod
  amount       Float
  amountLocal  Float?
  exchangeRate Float?
  reference    String?
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model ProductWaitlist {
  id        String     @id @default(uuid())
  name      String
  price     Float
  stock     Int        @default(0)
  barcode   String
  status    String     @default("PENDING")
  branchId  String?
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch?    @relation(fields: [branchId], references: [id])
  saleItems SaleItem[]
}

model SaleItem {
  id          String           @id @default(uuid())
  saleId      String
  variantId   String?
  waitlistId  String?
  quantity    Int
  price       Float
  cost        Float?
  discountAmt Float            @default(0)
  discountPct Float            @default(0)
  subtotal    Float
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant?  @relation(fields: [variantId], references: [id])
  waitlist    ProductWaitlist? @relation(fields: [waitlistId], references: [id])
}

model InventoryMovement {
  id            String         @id @default(uuid())
  variantId     String
  branchId      String
  type          MovementType
  quantity      Int
  reason        String
  referenceId   String?
  createdAt     DateTime       @default(now())
  newStock      Int            @default(0)
  previousStock Int            @default(0)
  branch        Branch         @relation(fields: [branchId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

model Client {
  id                          String              @id @default(uuid())
  name                        String
  documentId                  String?
  email                       String?
  phone                       String?
  address                     String?
  isActive                    Boolean             @default(true)
  walletBalance               Float               @default(0)
  creditLimit                 Float               @default(0)
  currentDebt                 Float               @default(0)
  downPaymentPercentage       Float               @default(50)
  paymentCycleDays            Int                 @default(15)
  lastPaymentDate             DateTime?
  nextPaymentDate             DateTime?
  creditScore                 Float               @default(50)
  totalPaymentsCount          Int                 @default(0)
  latePaymentsCount           Int                 @default(0)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  businessId                  String?
  accumulatedPoints           Int                 @default(0)
  isSuspended                 Boolean             @default(false)
  activationCode              String?
  activationCodeExpires       DateTime?
  password                    String?
  syncroCreditFrequencyDays   Int?
  syncroCreditMaxInstallments Int?
  business                    Business?           @relation(fields: [businessId], references: [id])
  creditTransactions          CreditTransaction[]
  deliveryOrders              DeliveryOrder[]
  loans                       Loan[]
  paymentSubmissions          PaymentSubmission[]
  redeemedRewards             RedeemedReward[]
  sales                       Sale[]
}

model CreditTransaction {
  id        String       @id @default(uuid())
  clientId  String
  amount    Float
  type      CreditTxType
  saleId    String?
  notes     String?
  createdAt DateTime     @default(now())
  client    Client       @relation(fields: [clientId], references: [id])
}

model Shift {
  id              String      @id @default(uuid())
  userId          String
  branchId        String
  openingBalance  Float       @default(0)
  closingBalance  Float       @default(0)
  expectedBalance Float       @default(0)
  difference      Float       @default(0)
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  notes           String?
  sales           Sale[]
  branch          Branch      @relation(fields: [branchId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
}

model AccountingEntry {
  id          String    @id @default(uuid())
  description String
  type        EntryType
  amount      Float
  category    String?
  saleId      String?   @unique
  branchId    String?
  userId      String
  createdAt   DateTime  @default(now())
  branch      Branch?   @relation(fields: [branchId], references: [id])
  sale        Sale?     @relation(fields: [saleId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model SupplierProduct {
  id            String          @id @default(uuid())
  supplierId    String
  productId     String
  variantId     String?
  purchasePrice Float
  minOrderQty   Int             @default(1)
  leadTimeDays  Int             @default(7)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId, variantId])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  number         String?             @unique
  supplierId     String
  branchId       String
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Float               @default(0)
  taxRate        Float               @default(0)
  taxAmount      Float               @default(0)
  discountAmount Float               @default(0)
  total          Float               @default(0)
  notes          String?
  expectedDate   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  branch         Branch              @relation(fields: [branchId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  invoices       SupplierInvoice[]
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  variantId       String
  quantity        Int
  cost            Float
  taxRate         Float          @default(0)
  taxAmount       Float          @default(0)
  discountAmount  Float          @default(0)
  subtotal        Float
  total           Float          @default(0)
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])
}

model SupplierInvoice {
  id              String                   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  total           Float
  balance         Float
  dueDate         DateTime
  status          InvoiceStatus            @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  purchaseOrder   PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier                 @relation(fields: [supplierId], references: [id])
  invoicePayments SupplierInvoicePayment[]
}

model SupplierPayment {
  id              String                   @id @default(uuid())
  supplierId      String
  amount          Float
  method          PaymentMethod
  reference       String?
  createdAt       DateTime                 @default(now())
  invoicePayments SupplierInvoicePayment[]
  supplier        Supplier                 @relation(fields: [supplierId], references: [id])
}

model SupplierInvoicePayment {
  id                String          @id @default(uuid())
  supplierInvoiceId String
  supplierPaymentId String
  amount            Float
  createdAt         DateTime        @default(now())
  invoice           SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  payment           SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)

  @@unique([supplierInvoiceId, supplierPaymentId])
}

model SupplierReturn {
  id         String         @id @default(uuid())
  supplierId String
  variantId  String
  quantity   Int
  reason     String
  createdAt  DateTime       @default(now())
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model InventoryTransfer {
  id                  String                  @id @default(uuid())
  sourceBranchId      String
  destinationBranchId String
  userId              String
  status              TransferStatus          @default(PENDING)
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  destinationBranch   Branch                  @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  sourceBranch        Branch                  @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  user                User                    @relation(fields: [userId], references: [id])
  items               InventoryTransferItem[]
}

model InventoryTransferItem {
  id         String            @id @default(uuid())
  transferId String
  variantId  String
  quantity   Int
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant    ProductVariant    @relation(fields: [variantId], references: [id])
}

model Expense {
  id          String    @id @default(uuid())
  branchId    String
  userId      String
  amount      Float
  category    String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String?
  branch      Branch    @relation(fields: [branchId], references: [id])
  business    Business? @relation(fields: [businessId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  branchId  String?
  userId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  branch    Branch?  @relation("BranchNotifications", fields: [branchId], references: [id])
  user      User?    @relation("UserNotifications", fields: [userId], references: [id])
}

model SavedProfile {
  id           String   @id @default(uuid())
  clientId     String
  email        String
  name         String
  role         String?
  businessName String?
  lastLogin    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, email])
}

model KnowledgeChunk {
  id        String   @id @default(uuid())
  content   String
  topic     String
  embedding String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiChatSession {
  id         String          @id @default(uuid())
  businessId String
  userId     String
  title      String          @default("Nuevo Chat")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  isArchived Boolean         @default(false)
  isPinned   Boolean         @default(false)
  messages   AiChatMessage[]
}

model AiChatMessage {
  id              String         @id @default(uuid())
  businessId      String
  userId          String
  role            String
  content         String
  createdAt       DateTime       @default(now())
  sessionId       String?        @default("default")
  actionConfirmed Boolean?       @default(false)
  actionJson      String?
  session         AiChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AiFeedback {
  id         String    @id @default(uuid())
  messageId  String?
  prompt     String
  response   String
  rating     String
  comment    String?
  createdAt  DateTime  @default(now())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
}

model Loan {
  id                String            @id @default(uuid())
  clientId          String
  amount            Float
  interestRate      Float
  totalToPay        Float
  remainingBalance  Float
  installmentsCount Int
  status            LoanStatus        @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  client            Client            @relation(fields: [clientId], references: [id])
  installments      LoanInstallment[]
}

model LoanInstallment {
  id                String            @id @default(uuid())
  loanId            String
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float             @default(0)
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Reward {
  id              String           @id @default(uuid())
  businessId      String
  name            String
  description     String?
  pointsCost      Int
  stock           Int              @default(0)
  image           String?
  createdAt       DateTime         @default(now())
  redeemedRewards RedeemedReward[]
}

model RedeemedReward {
  id          String   @id @default(uuid())
  clientId    String
  rewardId    String
  pointsSpent Int
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])
  reward      Reward   @relation(fields: [rewardId], references: [id])
}

model PaymentSubmission {
  id              String   @id @default(uuid())
  clientId        String
  businessId      String
  loanId          String?
  debtId          String
  amount          Float
  receiptUrl      String
  referenceNumber String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DeliveryOrder {
  id         String   @id @default(uuid())
  clientId   String
  businessId String
  branchId   String?
  products   Json
  total      Float
  lat        Float
  lng        Float
  address    String?
  status     String   @default("PENDING")
  phone      String?
  clientName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum SupplierStatus {
  ACTIVE
  BLOCKED
}

enum CreditTxType {
  DEBT
  PAYMENT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EntryType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  CREDIT
  PAGO_MOVIL
  BINANCE
  ZINLI
  PAYPAL
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

