generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id            String    @id @default(uuid())
  name          String
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  subscription  String    @default("BASIC")  // BASIC, PRO, ENTERPRISE
  logo          String?
  ruc           String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  users         User[]
  branches      Branch[]
  products      Product[]
  categories    Category[]
  suppliers     Supplier[]
  clients       Client[]
  sales         Sale[]
  settings      Setting[]
  expenses      Expense[]
  auditLogs     AuditLog[]
  conversations Conversation[]
}

model Conversation {
  id            String    @id @default(uuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  lastMessage   String?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String?
  type           String       @default("TEXT") // TEXT, IMAGE, VIDEO, AUDIO
  fileUrl        String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Product {
  id          String           @id @default(uuid())
  name        String
  description String?
  categoryId  String?
  supplierId  String?
  isWeighable Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  image       String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  variants    ProductVariant[]
  supplierProducts SupplierProduct[]
  
  businessId  String?
  business    Business?        @relation(fields: [businessId], references: [id])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  name       String
  sku        String      @unique
  barcode    String?     @unique
  secondaryBarcodes String[] @default([])
  price      Float
  cost       Float?
  promoPrice Float?
  bulkPrice  Float?
  stock      Int         @default(0)
  minStock   Int         @default(5)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  inventory  Inventory[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems  SaleItem[]
  movements  InventoryMovement[]
  
  // New relations for suppliers
  supplierProducts SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierReturns SupplierReturn[]
  saleReturnItems SaleReturnItem[]
  transferItems   InventoryTransferItem[]
}

model Inventory {
  id        String         @id @default(uuid())
  variantId String
  branchId  String
  quantity  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
}

model Supplier {
  id        String            @id @default(uuid())
  name      String            @unique
  taxId     String?           @unique
  phone     String?
  email     String?
  address   String?
  status    SupplierStatus    @default(ACTIVE)
  contactName String?
  paymentTerms String?       @default("CONTADO")
  creditDays  Int?          @default(0)
  website     String?
  notes       String?
  taxType     String?       @default("ORDINARIO") // ORDINARIO, ESPECIAL, EXENTO
  bankName    String?
  bankAccount String?
  bankId      String?
  bankPhone   String?
  currency    String?       @default("USD")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  
  businessId String?
  business   Business?        @relation(fields: [businessId], references: [id])
  
  // Relations
  products          Product[]
  supplierProducts  SupplierProduct[]
  purchaseOrders    PurchaseOrder[]
  supplierInvoices  SupplierInvoice[]
  supplierPayments  SupplierPayment[]
  supplierReturns   SupplierReturn[]
}

enum SupplierStatus {
  ACTIVE
  BLOCKED
}

model Branch {
  id               String              @id @default(uuid())
  name             String              @unique
  location         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  country          String?
  isMain           Boolean             @default(false)
  state            String?
  
  businessId       String?
  business         Business?           @relation(fields: [businessId], references: [id])
  
  inventory        Inventory[]
  sales            Sale[]
  inventoryMovements InventoryMovement[]
  shifts           Shift[]
  purchaseOrders   PurchaseOrder[]
  accountingEntries AccountingEntry[]
  waitlistItems     ProductWaitlist[]
  transfersSource   InventoryTransfer[] @relation("SourceBranch")
  transfersDest     InventoryTransfer[] @relation("DestinationBranch")
  expenses          Expense[]
  notifications     Notification[] @relation("BranchNotifications")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String?
  role             String            @default("pos")
  country          String?
  city             String?
  avatar           String?
  sales            Sale[]
  returns          SaleReturn[]
  shifts           Shift[]
  accountingEntries AccountingEntry[]
  permissions      String[]          @default([])
  branchIds        String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  businessId       String?
  business         Business?         @relation(fields: [businessId], references: [id])
  auditLogs         AuditLog[]
  messages          Message[]
  transfers         InventoryTransfer[]
  expenses          Expense[]
  notifications     Notification[] @relation("UserNotifications")
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Setting {
  id               String   @id @default(uuid())
  businessName     String   @default("Syncro POS")
  businessAddress  String?  // Keep for legacy
  businessPhone    String?  // Keep for legacy
  businessEmail    String?  // Keep for legacy
  businessIcon     String?
  
  // New standardized fields matching frontend state
  ruc              String?  @default("")
  address          String?  @default("")
  phone            String?  @default("")
  email            String?  @default("")
  website          String?  @default("")
  country          String?  @default("Venezuela")
  
  currency         String   @default("USD")
  exchangeRate     Float    @default(1)
  exchangeRateEur  Float    @default(1)
  bcvUpdateDate    String?
  
  // Dashboard Independent Rates
  exchangeRateDashboard    Float    @default(1)
  exchangeRateDashboardEur Float    @default(1)
  bcvUpdateDateDashboard   String?
  taxRate          Float    @default(16)
  taxEnabled       Boolean  @default(true)
  igtfRate         Float    @default(3)
  receiptFooter    String?  @default("Gracias por su compra. Vuelva pronto.")
  
  // Pago Móvil
  pagoMovilBank    String?
  pagoMovilId      String?
  pagoMovilPhone   String?
  pagoMovilEnabled Boolean? @default(false)
  
  // Cripto / Binance
  binanceId      String?
  binanceEmail   String?
  binanceEnabled Boolean? @default(false)
  
  // Zinli
  zinliEmail   String?
  zinliEnabled Boolean? @default(false)
  
  // PayPal
  paypalEmail   String?
  paypalEnabled Boolean? @default(false)

  // POS Configuration
  requireClient      Boolean  @default(false)
  printOnSale        Boolean  @default(true)
  lowStockAlert      Int      @default(5)
  allowNegativeStock Boolean  @default(false)
  
  // Printing Configuration
  defaultPrinter     String?  @default("")
  paperWidth         Int      @default(80)
  copiesPerSale      Int      @default(1)

  // Generic payment methods list
  paymentMethods Json?

  // Security PIN for POS discount authorization
  discountPin    String?
  pinPermissions Json?

  // Dashboard Metrics
  salesGoal      Float    @default(10000)
  showSalesGoal  Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  businessId      String?
  business        Business?        @relation(fields: [businessId], references: [id])
}

model Sale {
  id            String         @id @default(uuid())
  branchId      String
  userId        String
  clientId      String?
  paymentMethod PaymentMethod? // Deprecated in favor of payments relation
  subtotal      Float          @default(0)
  taxAmount     Float          @default(0)
  igtfAmount    Float          @default(0)
  discountAmt   Float          @default(0)
  discountPct   Float          @default(0)
  total         Float
  status        String         @default("COMPLETED") // COMPLETED, CANCELLED
  shiftId       String?
  createdAt     DateTime       @default(now())
  
  branch        Branch         @relation(fields: [branchId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  shift         Shift?         @relation(fields: [shiftId], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  returns       SaleReturn[]
  accountingEntry AccountingEntry?
  
  businessId    String?
  business      Business?      @relation(fields: [businessId], references: [id])
}

model SaleReturn {
  id            String           @id @default(uuid())
  saleId        String
  userId        String
  reason        String?
  subtotal      Float            @default(0)
  taxAmount     Float            @default(0)
  total         Float
  createdAt     DateTime         @default(now())
  
  sale          Sale             @relation(fields: [saleId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  items         SaleReturnItem[]
}

model SaleReturnItem {
  id            String           @id @default(uuid())
  returnId      String
  variantId     String?
  quantity      Int
  price         Float
  subtotal      Float
  
  return        SaleReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant       ProductVariant?  @relation(fields: [variantId], references: [id])
}

model SalePayment {
  id             String        @id @default(uuid())
  saleId         String
  method         PaymentMethod
  amount         Float         // Amount in USD (Main currency)
  amountLocal    Float?        // Amount in local currency (VES) at time of sale
  exchangeRate   Float?        // Rate at time of sale
  reference      String?       // Confirmation #, last 4 digits, etc.
  
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model ProductWaitlist {
  id        String   @id @default(uuid())
  name      String
  price     Float
  stock     Int      @default(0)
  barcode   String   @unique
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  branchId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch?  @relation(fields: [branchId], references: [id])
  saleItems SaleItem[]
}

model SaleItem {
  id         String         @id @default(uuid())
  saleId     String
  variantId  String?
  waitlistId String?
  quantity   Int
  price      Float
  cost       Float?
  discountAmt Float        @default(0)
  discountPct Float        @default(0)
  subtotal   Float
  
  sale       Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  waitlist   ProductWaitlist? @relation(fields: [waitlistId], references: [id])
}

model InventoryMovement {
  id          String        @id @default(uuid())
  variantId   String
  branchId    String
  type        MovementType
  quantity    Int
  reason      String        // e.g., "sale", "restock", "adjustment"
  referenceId String?       // e.g., saleId
  createdAt   DateTime      @default(now())
  
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  branch      Branch         @relation(fields: [branchId], references: [id])
}

model Client {
  id              String   @id @default(uuid())
  name            String
  documentId      String?
  email           String?
  phone           String?
  address         String?
  isActive        Boolean  @default(true)
  walletBalance   Float    @default(0)
  creditLimit     Float    @default(0)
  currentDebt     Float    @default(0)
  
  // New Credit Tracking Fields
  downPaymentPercentage Float   @default(50)
  paymentCycleDays      Int     @default(15)
  lastPaymentDate       DateTime?
  nextPaymentDate       DateTime?
  
  // Credit Scoring & Behavior
  creditScore           Float     @default(50) // 0 to 100
  totalPaymentsCount    Int       @default(0)
  latePaymentsCount     Int       @default(0)
  
  sales           Sale[]
  creditTransactions CreditTransaction[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  businessId      String?
  business        Business?      @relation(fields: [businessId], references: [id])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  clientId    String
  amount      Float    
  type        CreditTxType
  saleId      String?
  notes       String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])
}

enum CreditTxType {
  DEBT
  PAYMENT
}

model Shift {
  id              String      @id @default(uuid())
  userId          String
  branchId        String
  openingBalance  Float       @default(0)
  closingBalance  Float       @default(0)
  expectedBalance Float       @default(0)
  difference      Float       @default(0)
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  notes           String?
  user            User        @relation(fields: [userId], references: [id])
  branch          Branch      @relation(fields: [branchId], references: [id])
  sales           Sale[]
}

model AccountingEntry {
  id          String    @id @default(uuid())
  description String
  type        EntryType
  amount      Float
  category    String?
  saleId      String?   @unique
  branchId    String?
  userId      String
  createdAt   DateTime  @default(now())
  
  sale        Sale?     @relation(fields: [saleId], references: [id])
  branch      Branch?   @relation(fields: [branchId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EntryType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  CREDIT
  PAGO_MOVIL
  BINANCE
  ZINLI
  PAYPAL
}

// Supplier Products - Products asociados a proveedores
model SupplierProduct {
  id            String  @id @default(uuid())
  supplierId    String
  productId     String
  variantId     String?
  purchasePrice Float
  minOrderQty   Int     @default(1)
  leadTimeDays  Int     @default(7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  @@unique([supplierId, productId, variantId])
}

// Purchase Orders - Órdenes de compra
model PurchaseOrder {
  id        String            @id @default(uuid())
  number    String?           @unique // Sequential order number (OC-001)
  supplierId String
  branchId  String
  status    PurchaseOrderStatus @default(DRAFT)
  subtotal  Float             @default(0)
  taxRate   Float             @default(0)
  taxAmount Float             @default(0)
  discountAmount Float       @default(0)
  total     Float             @default(0)
  notes     String?
  expectedDate DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  
  // Relations
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  branch   Branch             @relation(fields: [branchId], references: [id])
  items    PurchaseOrderItem[]
  invoices SupplierInvoice[]
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

// Purchase Order Items - Items de órdenes de compra
model PurchaseOrderItem {
  id             String  @id @default(uuid())
  purchaseOrderId String
  variantId      String
  quantity       Int
  cost           Float
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  discountAmount Float   @default(0)
  subtotal       Float
  total          Float   @default(0)
  
  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

// Supplier Invoices - Facturas de proveedores
model SupplierInvoice {
  id             String              @id @default(uuid())
  supplierId     String
  purchaseOrderId String?
  total          Float
  balance        Float
  dueDate        DateTime
  status         InvoiceStatus        @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  // Relations
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  invoicePayments SupplierInvoicePayment[]
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
}

// Supplier Payments - Pagos a proveedores
model SupplierPayment {
  id         String        @id @default(uuid())
  supplierId String
  amount     Float
  method     PaymentMethod
  reference  String?
  createdAt  DateTime      @default(now())
  
  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id])
  invoicePayments SupplierInvoicePayment[]
}

// Invoice-Payment junction table
model SupplierInvoicePayment {
  id               String @id @default(uuid())
  supplierInvoiceId String
  supplierPaymentId String
  amount           Float
  createdAt        DateTime @default(now())
  
  // Relations
  invoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  
  @@unique([supplierInvoiceId, supplierPaymentId])
}

// Supplier Returns - Devoluciones a proveedores
model SupplierReturn {
  id         String  @id @default(uuid())
  supplierId String
  variantId  String
  quantity   Int
  reason     String
  createdAt  DateTime @default(now())
  
  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}


model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN", "SALE"
  entity    String   // e.g., "PRODUCT", "SALE", "INVENTORY"
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
}
model InventoryTransfer {
  id                    String                @id @default(uuid())
  sourceBranchId        String
  destinationBranchId   String
  userId                String
  status                TransferStatus        @default(PENDING)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  sourceBranch          Branch                @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  destinationBranch     Branch                @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id])
  items                 InventoryTransferItem[]
}

model InventoryTransferItem {
  id                    String                @id @default(uuid())
  transferId            String
  variantId             String
  quantity              Int

  transfer              InventoryTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant               ProductVariant        @relation(fields: [variantId], references: [id])
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Expense {
  id          String   @id @default(uuid())
  branchId    String
  userId      String
  amount      Float
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // SALE, EXPENSE, TRANSFER, ALERT
  title     String
  message   String
  branchId  String?
  userId    String?  // Target user (null means global/all admins)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  branch    Branch?  @relation(fields: [branchId], references: [id], name: "BranchNotifications")
  user      User?    @relation(fields: [userId], references: [id], name: "UserNotifications")
}
