// ─── Gym module ──────────────────────────────────────────────────────────────

model GymPlan {
  id                  String          @id @default(uuid())
  businessId          String
  name                String
  description         String?
  durationDays        Int
  /// Valid in every branch (members of any branch can enter); otherwise only in the member's branch
  allBranches         Boolean         @default(false)
  price               Float
  color               String?
  /// Days a membership of this plan can be frozen (0 = not allowed)
  maxFreezeDays       Int             @default(0)
  /// Free guest passes per month for members on this plan
  guestPassesPerMonth Int             @default(0)
  /// When members can come in: [{ days: [1..5], start: "06:00", end: "12:00" }]; empty = any time
  accessWindows       Json?
  /// Entries allowed per day and per week (0 = no limit)
  maxEntriesPerDay    Int             @default(0)
  maxEntriesPerWeek   Int             @default(0)
  /// Pack of visits (e.g. 12 entries) used up by check-ins; 0 = unlimited
  totalEntries        Int             @default(0)
  /// Whether members can book group classes, and which ones (empty = all)
  includesClasses     Boolean         @default(true)
  allowedClassIds     String[]        @default([])
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships         GymMembership[]

  @@index([businessId])
}

model GymMember {
  id               String            @id @default(uuid())
  businessId       String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId         String?
  clientId         String            @unique
  memberNumber     Int
  photoUrl         String?
  birthDate        DateTime?
  gender           String?
  emergencyContact String?
  emergencyPhone   String?
  medicalNotes     String?
  goal             String?
  notes            String?
  /// Manual block at the door regardless of the membership
  accessEnabled    Boolean           @default(true)
  /// Person id on the face reader (Hikvision employeeNo)
  deviceUserId     String?
  faceSyncedAt     DateTime?
  /// Last error from the face reader when loading this member (bad photo, no face found…)
  faceError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  memberships      GymMembership[]
  checkIns         GymCheckIn[]
  reminders        GymReminder[]
  bookings         GymBooking[]
  notifications    GymNotification[]
  leads            GymLead[]
  hostedVisits     GymVisit[]        @relation("VisitHost")
  signatures       GymSignature[]
  routines         GymRoutine[]
  workoutLogs      GymWorkoutLog[]
  assessments      GymAssessment[]

  reportedPayments GymReportedPayment[]

  @@unique([businessId, memberNumber])
  @@index([branchId], map: "GymMember_branch_idx")
}

model GymMembership {
  id             String        @id @default(uuid())
  businessId     String
  memberId       String
  planId         String
  planName       String
  startDate      DateTime
  endDate        DateTime
  price          Float
  discount       Float         @default(0)
  /// Extra charges: enrollment, reactivation, freeze fee… ([{ label, amount }])
  fees           Float         @default(0)
  feeItems       Json?
  /// ACTIVE, FROZEN or CANCELLED; "expired" and "scheduled" come from the dates
  status         String        @default("ACTIVE")
  frozenAt       DateTime?
  frozenDaysUsed Int           @default(0)
  /// Scheduled freeze: starts and ends on its own
  freezeFrom     DateTime?
  freezeUntil    DateTime?
  freezeReason   String?
  freezeCount    Int           @default(0)
  cancelledAt    DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member         GymMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan           GymPlan       @relation(fields: [planId], references: [id])
  payments       GymPayment[]
  reminders      GymReminder[]

  @@index([memberId], map: "GymMembership_member_idx")
  @@index([businessId, endDate], map: "GymMembership_business_end_idx")
}

model GymPayment {
  id                String         @id @default(uuid())
  businessId        String
  membershipId      String?
  /// Day pass or guest pass charged at reception (instead of a membership)
  visitId           String?
  amount            Float
  method            String
  reference         String?
  exchangeRate      Float?
  currency          String?
  amountCurrency    Float?
  createdById       String?
  /// Branch and open cash shift where it was charged; its income entry in accounting
  branchId          String?
  shiftId           String?
  accountingEntryId String?
  /// The sale this charge created (shows in sales, history and reports like a POS sale)
  saleId            String?
  createdAt         DateTime       @default(now())
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership        GymMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  visit             GymVisit?      @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt], map: "GymPayment_business_created_idx")
  @@index([shiftId], map: "GymPayment_shiftId_idx")
}

model GymCheckIn {
  id         String     @id @default(uuid())
  businessId String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId   String?
  memberId   String?
  granted    Boolean
  reason     String?
  /// MANUAL, FACE, QR
  method     String     @default("MANUAL")
  deviceId   String?
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id])
  member     GymMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt], map: "GymCheckIn_business_created_idx")
  @@index([branchId], map: "GymCheckIn_branch_idx")
}

model GymReminder {
  id           String        @id @default(uuid())
  businessId   String
  membershipId String
  memberId     String
  /// BEFORE (days before it ends), EXPIRY (the day it ends), AFTER (days after, if not renewed)
  kind         String
  /// SENT or FAILED
  status       String
  phone        String?
  error        String?
  /// Sent by hand from the member's card
  manual       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   GymMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  member       GymMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt], map: "GymReminder_business_created_idx")
  @@index([membershipId, kind], map: "GymReminder_membership_kind_idx")
}

model GymTrainer {
  id           String                 @id @default(uuid())
  businessId   String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId     String?
  name         String
  phone        String?
  specialty    String?
  photoUrl     String?
  color        String?
  /// TRAINER, RECEPTION, MANAGER, CLEANING or OTHER (the gym's staff, not only trainers)
  role         String                 @default("TRAINER")
  /// Pay per hour, to estimate the cost of the shifts
  hourlyRate   Float?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @default(now()) @updatedAt
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?                @relation(fields: [branchId], references: [id])
  classes      GymClass[]
  sessions     GymClassSession[]
  availability GymStaffAvailability[]
  shifts       GymStaffShift[]
  routines     GymRoutine[]
  assessments  GymAssessment[]

  @@index([businessId])
  @@index([branchId], map: "GymTrainer_branch_idx")
}

/// A class on the weekly schedule (e.g. Spinning, Monday and Wednesday at 7:00)
model GymClass {
  id          String            @id @default(uuid())
  businessId  String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId    String?
  name        String
  description String?
  color       String?
  trainerId   String?
  /// 0 = Sunday … 6 = Saturday
  daysOfWeek  Int[]             @default([])
  /// Local time, "HH:MM"
  startTime   String
  durationMin Int               @default(60)
  capacity    Int               @default(20)
  room        String?
  isActive    Boolean           @default(true)
  /// Prospects can book their free trial in this class
  allowTrial  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id])
  trainer     GymTrainer?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  sessions    GymClassSession[]

  @@index([businessId])
  @@index([branchId], map: "GymClass_branch_idx")
}

/// One dated occurrence of a class; bookings belong to it
model GymClassSession {
  id               String       @id @default(uuid())
  businessId       String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId         String?
  classId          String
  trainerId        String?
  startsAt         DateTime
  endsAt           DateTime
  capacity         Int
  /// SCHEDULED or CANCELLED
  status           String       @default("SCHEDULED")
  cancelReason     String?
  /// Weekly slot it came from when it was moved to another time (so that slot isn't recreated)
  originalStartsAt DateTime?
  /// One-time session added outside the weekly schedule
  isExtra          Boolean      @default(false)
  createdAt        DateTime     @default(now())
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id])
  class            GymClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  trainer          GymTrainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trialLeads       GymLead[]
  bookings         GymBooking[]

  @@unique([classId, startsAt])
  @@index([businessId, startsAt], map: "GymClassSession_business_starts_idx")
  @@index([classId, originalStartsAt], map: "GymClassSession_class_original_idx")
  @@index([branchId], map: "GymClassSession_branch_idx")
}

model GymBooking {
  id         String          @id @default(uuid())
  businessId String
  sessionId  String
  memberId   String
  /// BOOKED, WAITLIST, CANCELLED, ATTENDED or NO_SHOW
  status     String          @default("BOOKED")
  /// STAFF (reception) or PORTAL (the member's app)
  source     String          @default("STAFF")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session    GymClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member     GymMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId], map: "GymBooking_member_idx")
}

/// WhatsApp notices about classes (cancelled, moved, spot from the waiting list)
model GymNotification {
  id         String     @id @default(uuid())
  businessId String
  memberId   String?
  /// For prospects (trial class confirmations)
  leadId     String?
  sessionId  String?
  /// CLASS_CANCELLED, CLASS_MOVED, WAITLIST_PROMOTED or TRIAL_BOOKED
  kind       String
  /// SENT, FAILED or SKIPPED (no phone, WhatsApp off)
  status     String
  phone      String?
  text       String?
  error      String?
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member     GymMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt], map: "GymNotification_business_created_idx")
}

/// Weekly hours a staff member can work (one row per day and range)
model GymStaffAvailability {
  id         String     @id @default(uuid())
  businessId String
  staffId    String
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek  Int
  startTime  String
  endTime    String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      GymTrainer @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId], map: "GymStaffAvailability_staff_idx")
}

/// A work shift of a staff member, with clock in and out
model GymStaffShift {
  id         String     @id @default(uuid())
  businessId String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId   String?
  staffId    String
  startsAt   DateTime
  endsAt     DateTime
  /// Where they work: Recepción, Piso, Clases, Limpieza…
  area       String?
  notes      String?
  /// SCHEDULED, DONE or ABSENT
  status     String     @default("SCHEDULED")
  clockInAt  DateTime?
  clockOutAt DateTime?
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id])
  staff      GymTrainer @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt], map: "GymStaffShift_business_starts_idx")
  @@index([staffId, startsAt], map: "GymStaffShift_staff_starts_idx")
  @@index([branchId], map: "GymStaffShift_branch_idx")
}

/// A prospect: someone interested who isn't a member yet
model GymLead {
  id             String            @id @default(uuid())
  businessId     String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId       String?
  name           String
  phone          String?
  email          String?
  documentId     String?
  /// WALK_IN, INSTAGRAM, FACEBOOK, REFERRAL, WHATSAPP, WEB, GUEST or OTHER
  source         String?           @default("WALK_IN")
  interest       String?
  /// NEW, CONTACTED, TRIAL_SCHEDULED, TRIAL_DONE, WON or LOST
  stage          String            @default("NEW")
  lostReason     String?
  notes          String?
  ownerName      String?
  nextFollowUpAt DateTime?
  trialSessionId String?
  trialAt        DateTime?
  memberId       String?
  wonAt          DateTime?
  lostAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id])
  trialSession   GymClassSession?  @relation(fields: [trialSessionId], references: [id], onDelete: SetNull)
  member         GymMember?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  activities     GymLeadActivity[]
  visits         GymVisit[]

  @@index([businessId, stage], map: "GymLead_business_stage_idx")
  @@index([trialSessionId], map: "GymLead_trial_session_idx")
  @@index([branchId], map: "GymLead_branch_idx")
}

/// Timeline of a prospect: notes, calls, messages, stage changes
model GymLeadActivity {
  id         String   @id @default(uuid())
  businessId String
  leadId     String
  /// NOTE, CALL, WHATSAPP, STAGE, TRIAL or VISIT
  type       String
  text       String
  userName   String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead       GymLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt], map: "GymLeadActivity_lead_created_idx")
}

/// Someone who came in without a membership: a member's guest, a day pass or a visitor
model GymVisit {
  id           String       @id @default(uuid())
  businessId   String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId     String?
  /// GUEST (invited by a member), DAY_PASS (paid) or VISITOR (doesn't train)
  kind         String
  name         String
  documentId   String?
  phone        String?
  hostMemberId String?
  leadId       String?
  price        Float        @default(0)
  notes        String?
  checkedInAt  DateTime     @default(now())
  checkedOutAt DateTime?
  createdById  String?
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  hostMember   GymMember?   @relation("VisitHost", fields: [hostMemberId], references: [id], onDelete: SetNull)
  lead         GymLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  payments     GymPayment[]

  @@index([businessId, checkedInAt], map: "GymVisit_business_checkin_idx")
  @@index([hostMemberId, checkedInAt], map: "GymVisit_host_checkin_idx")
  @@index([branchId], map: "GymVisit_branch_idx")
}

/// Contract, waiver or consent the members sign (versioned: editing the text asks for a new signature)
model GymDocumentTemplate {
  id         String         @id @default(uuid())
  businessId String
  /// CONTRACT, WAIVER, HEALTH, PHOTO or OTHER
  kind       String         @default("WAIVER")
  title      String
  /// Text with {nombre}, {cedula}, {plan}, {fecha}, {gimnasio}
  body       String
  /// Every member must sign it
  required   Boolean        @default(true)
  version    Int            @default(1)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  signatures GymSignature[]

  @@index([businessId], map: "GymDocumentTemplate_business_idx")
}

/// A signed copy: the exact text the member accepted, with the signature image
model GymSignature {
  id             String              @id @default(uuid())
  businessId     String
  templateId     String
  memberId       String
  version        Int
  title          String
  body           String
  signerName     String
  signerDocument String?
  signatureUrl   String
  /// RECEPTION or PORTAL
  method         String              @default("RECEPTION")
  ip             String?
  userAgent      String?
  signedAt       DateTime            @default(now())
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template       GymDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  member         GymMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "GymSignature_member_idx")
  @@index([templateId, memberId], map: "GymSignature_template_member_idx")
}

/// A machine or piece of equipment of the gym
model GymEquipment {
  id               String           @id @default(uuid())
  businessId       String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId         String?
  name             String
  /// CARDIO, STRENGTH, FREE_WEIGHTS, FUNCTIONAL or OTHER
  category         String           @default("STRENGTH")
  brand            String?
  model            String?
  serial           String?
  area             String?
  photoUrl         String?
  purchaseDate     DateTime?
  purchasePrice    Float?
  warrantyUntil    DateTime?
  /// OK, NEEDS_SERVICE, OUT_OF_ORDER or RETIRED
  status           String           @default("OK")
  /// Preventive service every N days (0 = none)
  serviceEveryDays Int              @default(0)
  lastServiceAt    DateTime?
  nextServiceAt    DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id])
  maintenance      GymMaintenance[]

  @@index([businessId], map: "GymEquipment_business_idx")
  @@index([branchId], map: "GymEquipment_branch_idx")
}

/// A repair, a preventive service or an inspection of a machine
model GymMaintenance {
  id                String       @id @default(uuid())
  businessId        String
  equipmentId       String
  /// REPAIR, PREVENTIVE or INSPECTION
  kind              String       @default("REPAIR")
  /// OPEN, IN_PROGRESS or DONE
  status            String       @default("OPEN")
  title             String
  description       String?
  /// Who reported it: staff name or "Socio: name"
  reportedBy        String?
  scheduledFor      DateTime?
  doneAt            DateTime?
  cost              Float?
  vendor            String?
  resolution        String?
  accountingEntryId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment         GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([businessId, status], map: "GymMaintenance_business_status_idx")
  @@index([equipmentId], map: "GymMaintenance_equipment_idx")
}

/// An exercise of the library
model GymExercise {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  /// CHEST, BACK, LEGS, GLUTES, SHOULDERS, ARMS, CORE, CARDIO or FULL_BODY
  muscleGroup  String
  equipment    String?
  instructions String?
  videoUrl     String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, muscleGroup], map: "GymExercise_business_group_idx")
}

/// A training plan by days. A template (no member) or a copy assigned to a member.
model GymRoutine {
  id          String          @id @default(uuid())
  businessId  String
  name        String
  goal        String?
  /// BEGINNER, INTERMEDIATE or ADVANCED
  level       String          @default("BEGINNER")
  description String?
  memberId    String?
  trainerId   String?
  templateId  String?
  /// [{ name, exercises: [{ exerciseId, name, sets, reps, weight, restSec, notes }] }]
  days        Json
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member      GymMember?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer     GymTrainer?     @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  logs        GymWorkoutLog[]

  @@index([businessId, memberId], map: "GymRoutine_business_member_idx")
}

/// A workout the member did (from their app or at the gym)
model GymWorkoutLog {
  id         String      @id @default(uuid())
  businessId String
  memberId   String
  routineId  String?
  dayIndex   Int?
  dayName    String?
  /// [{ exerciseId, name, sets: [{ reps, weight }] }]
  entries    Json?
  notes      String?
  doneAt     DateTime    @default(now())
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member     GymMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routine    GymRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  @@index([memberId, doneAt], map: "GymWorkoutLog_member_done_idx")
}

/// Body measurements of a member on a date
model GymAssessment {
  id            String      @id @default(uuid())
  businessId    String
  memberId      String
  trainerId     String?
  date          DateTime    @default(now())
  weightKg      Float?
  heightCm      Float?
  bodyFatPct    Float?
  muscleMassKg  Float?
  waistCm       Float?
  hipCm         Float?
  chestCm       Float?
  armCm         Float?
  thighCm       Float?
  restingHr     Int?
  bloodPressure String?
  notes         String?
  photos        String[]    @default([])
  createdAt     DateTime    @default(now())
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member        GymMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer       GymTrainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([memberId, date], map: "GymAssessment_member_date_idx")
}

/// A face reader at the door (Hikvision), managed through the local bridge on the gym's server
model GymDevice {
  id         String           @id @default(uuid())
  businessId String
  /// Sede (sucursal) where it lives; the main branch sees every branch by switching
  branchId   String?
  name       String
  model      String           @default("DS-K1T341CMFW")
  location   String?
  /// VALIDITY: the reader decides with the dates Syncro loads; STRICT: Syncro decides each entry
  mode       String           @default("VALIDITY")
  doorNo     Int              @default(1)
  /// The bridge authenticates with this key (only its hash is kept)
  keyPrefix  String           @unique
  keyHash    String
  isActive   Boolean          @default(true)
  lastSeenAt DateTime?
  lastSyncAt DateTime?
  /// What the bridge reports: device online, firmware, users and faces on the reader, last error
  status     Json?
  /// Pending orders for the bridge: [{ id, type: "OPEN_DOOR" | "RESYNC", at }]
  commands   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id])
  events     GymDeviceEvent[]

  @@index([businessId], map: "GymDevice_business_idx")
  @@index([branchId], map: "GymDevice_branch_idx")
}

/// Each recognition sent by the reader (kept once, by its serial number on the device)
model GymDeviceEvent {
  id            String    @id @default(uuid())
  businessId    String
  deviceId      String
  serialNo      String
  employeeNo    String?
  memberId      String?
  /// What the reader did and what Syncro decided
  deviceGranted Boolean
  syncroGranted Boolean?
  reason        String?
  minor         Int?
  occurredAt    DateTime
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  device        GymDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, serialNo], map: "GymDeviceEvent_device_serial_key")
  @@index([businessId, occurredAt], map: "GymDeviceEvent_business_time_idx")
}

/// Keys for outside tools (the WhatsApp agent) to call the gym API on behalf of a business.
model GymApiKey {
  id         String    @id @default(uuid())
  businessId String
  name       String
  keyPrefix  String    @unique
  keyHash    String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "GymApiKey_business_idx")
}

/// A payment the member reported to the WhatsApp agent (pago móvil). Reception checks it and
/// registers the renewal; the agent never confirms a payment.
model GymReportedPayment {
  id         String    @id @default(uuid())
  businessId String
  branchId   String?
  memberId   String
  planId     String?
  planName   String?
  /// As the member wrote it ("Bs 21.784,22") and as a number when it could be read
  amountText String
  amount     Float?
  currency   String?
  bank       String?
  reference  String?
  /// PENDING, CONFIRMED or REJECTED
  status     String    @default("PENDING")
  note       String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?   @relation(fields: [branchId], references: [id])
  member     GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([businessId, status], map: "GymReportedPayment_business_status_idx")
}

/// Money in or out that isn't a sale: rent, services, payroll, an owner's contribution…
/// Never deleted: a wrong one is voided with a reason. Cash from the drawer moves the shift.
model FinanceMovement {
  id                String    @id @default(uuid())
  businessId        String
  branchId          String
  userId            String
  userName          String?
  /// IN or OUT
  type              String
  category          String
  /// Written by the person when the category is CUSTOM
  categoryLabel     String?
  /// In dollars; `currency` and `amountCurrency` say what was handed over
  amount            Float
  currency          String    @default("USD")
  amountCurrency    Float
  /// CASH_DRAWER (out of / into the open cash shift), CASH_OTHER, PAGO_MOVIL, TRANSFER, CARD, ZELLE, BINANCE, OTHER
  method            String
  /// Written by the person when the method is CUSTOM
  methodLabel       String?
  description       String?
  receiptUrl        String?
  occurredAt        DateTime  @default(now())
  /// Where it was registered from: GYM, DASHBOARD or POS
  source            String    @default("DASHBOARD")
  shiftId           String?
  accountingEntryId String?
  /// Supervisor who authorized it with the PIN (over the staff limit or a protected category)
  authorizedBy      String?
  /// ACTIVE or VOIDED
  status            String    @default("ACTIVE")
  voidReason        String?
  voidedAt          DateTime?
  voidedBy          String?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime  @default(now())
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch    @relation(fields: [branchId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([businessId, branchId, occurredAt], map: "FinanceMovement_branch_day_idx")
  @@index([shiftId], map: "FinanceMovement_shift_idx")
}
