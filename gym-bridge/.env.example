# Syncro (la dirección del backend y la clave que te dio Syncro al crear el lector)
SYNCRO_URL=https://api.tu-syncro.com
DEVICE_KEY=gymk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lector Hikvision en la red local (IP fija) y un usuario con permisos de administrador
DEVICE_HOST=http://192.168.1.50
DEVICE_USER=admin
DEVICE_PASS=tu-clave-del-lector

# Opcional
# DOOR_NO=1                  # puerta que controla el lector (casi siempre 1)
# FACE_LIBRARY=1             # biblioteca de rostros (FDID) del lector
# EVENT_POLL_SECONDS=2
# ROSTER_SYNC_SECONDS=60
# PASS_MINORS=1,38,75        # códigos de evento de acceso permitido (rostro = 75)
# FAIL_MINORS=6,9,10,21,76   # códigos de acceso negado (rostro no coincide = 76)
# STATE_FILE=./state.json
