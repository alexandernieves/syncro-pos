# Copy to backend.env (same folder as docker-compose.yml). Never commit it.
NODE_ENV=production
JWT_SECRET=pon-aqui-un-texto-aleatorio-largo
COOKIE_SECRET=pon-aqui-otro-texto-aleatorio-largo

# Public address of the panel and of its API
API_URL=https://ebanocontrol.total-net.net/api
PORTAL_URL=https://ebanocontrol.total-net.net/portal
ALLOWED_ORIGINS=https://ebanocontrol.total-net.net

# Photos and receipts (AWS S3)
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LIVENESS_REGION=
AWS_LIVENESS_ROLE_ARN=

# WhatsApp (Evolution API): set in docker-compose.yml from EVOLUTION_API_KEY in .env

# Web push notifications
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Identificadores de usuarios syncropos autorizados para la tesorería corporativa.
SYNCRO_FINANCE_ADMIN_IDS=

# Nubi Finanzas: genera un valor exclusivo con openssl rand -hex 32.
SYNCRO_FINANCE_WHATSAPP_WEBHOOK_SECRET=
# Opcional. Docker reutiliza el origen interno de BACKEND_WEBHOOK_URL.
# SYNCRO_FINANCE_WHATSAPP_BACKEND_URL=http://ebanocontrol-backend:9000
# Opcional. Requiere un modelo con visión, PDF nativo y proveedor ZDR.
# SYNCRO_FINANCE_OPENROUTER_MODEL=anthropic/claude-opus-5.5
