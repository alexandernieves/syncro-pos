# Copy to backend.env (same folder as docker-compose.yml). Never commit it.
NODE_ENV=production
JWT_SECRET=pon-aqui-un-texto-aleatorio-largo
COOKIE_SECRET=pon-aqui-otro-texto-aleatorio-largo

# Public address of the panel and of its API
API_URL=https://ebanocontrol.total-net.net/api
PORTAL_URL=https://ebanocontrol.total-net.net/portal
ALLOWED_ORIGINS=https://ebanocontrol.total-net.net

# Photos and receipts (AWS S3)
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LIVENESS_REGION=
AWS_LIVENESS_ROLE_ARN=

# WhatsApp (Evolution API) until Koenyx is connected
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
BACKEND_WEBHOOK_URL=https://ebanocontrol.total-net.net/api

# Web push notifications
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
