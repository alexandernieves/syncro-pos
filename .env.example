# Copy to .env (same folder as docker-compose.yml). Never commit it.
DB_PASSWORD=cambia-esta-clave-larga
# Port on 127.0.0.1 where the panel answers (the server's web server forwards the domain here)
EBANO_PORT=8095
# 127.0.0.1 if the web server runs on the host (nginx, Caddy); 172.17.0.1 if it runs in Docker (Nginx Proxy Manager, Traefik)
EBANO_BIND=127.0.0.1
DB_PORT=5442
