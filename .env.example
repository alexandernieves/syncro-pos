# Copy to .env (same folder as docker-compose.yml). Never commit it.
DB_PASSWORD=cambia-esta-clave-larga
# Port on 127.0.0.1 where the panel answers (the server's web server forwards the domain here)
EBANO_PORT=8095
# 127.0.0.1 if the web server runs on the host (nginx, Caddy); 172.17.0.1 if it runs in Docker (Nginx Proxy Manager, Traefik)
EBANO_BIND=127.0.0.1
DB_PORT=5442
# Key between the backend and the WhatsApp container (Evolution API). Generate it with: openssl rand -hex 24
EVOLUTION_API_KEY=

# Remote assistance between different networks (TURN). Leave empty to use only direct connections.
# Generate the secret with: openssl rand -hex 32
TURN_SECRET=
# The name or IP the computers use to reach this server's TURN (UDP/TCP 3478 open)
TURN_HOST=ebanocontrol.total-net.net
# Public IP of this server; behind the router's NAT write "public/private" (e.g. 201.221.112.113/192.168.1.20)
TURN_EXTERNAL_IP=
# Only behind NAT: the server's private IP (the same one after the slash above)
TURN_PRIVATE_IP=
