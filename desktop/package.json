{
  "name": "syncro-desktop",
  "productName": "Syncro POS",
  "version": "1.3.0",
  "description": "Syncro desktop app: opens the business's Syncro server and prints tickets directly",
  "author": "Syncro",
  "private": true,
  "main": "src/main.js",
  "syncro": {
    "defaultServer": "https://ebanocontrol.total-net.net",
    "releases": {
      "owner": "alexandernieves",
      "repo": "syncro-pos"
    }
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.syncro.pos",
    "productName": "Syncro POS",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      {
        "from": "../gym-bridge/src",
        "to": "src/gym-bridge",
        "filter": [
          "core.js",
          "isapi.js"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "alexandernieves",
      "repo": "syncro-pos",
      "releaseType": "draft"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Syncro-POS-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Syncro POS"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Syncro usa el micrófono para hablar con el equipo de Syncro durante la asistencia en vivo."
      },
      "artifactName": "Syncro-POS-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
